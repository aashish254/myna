# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.pytest_cache/
bench/out/

# runs/ holds checkpoints and scratch. G7 promises committed witnesses, so the
# small tables (.json/.md/.log) stay tracked; weights directories, *.pt dumps and
# the latency harness's .lock file do not.
runs/*
!runs/*.json
!runs/*.md
!runs/*.log

# Derived corpora: the rows are upstream text, so only the provenance file stays in git
# (it pins revisions, seeds, collision counts and the sha256 of the generated train.jsonl).
data/*
!data/decision-v2-pilot/
data/decision-v2-pilot/*
!data/decision-v2-pilot/upstream_manifest.json
