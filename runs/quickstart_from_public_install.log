$ /tmp/venv-pub/bin/python    # the README snippet, verbatim, plus the three numbers it claims
from myna import Myna, fetch_weights
myna = Myna(fetch_weights())
out = myna.predict("My order never arrived and I want a refund.", {
    "department": {"type": "choice",
                   "instructions": "Which team should handle this ticket?",
                   "criteria": ["billing", "technical", "shipping", "returns", "other"]}})
print(out["answers"]["department"]["choice"])
a = out["answers"]["department"]
p = a["probabilities"]
low = min(p, key=p.get)
print(f"confidence {a['confidence']} weakest {low} {p[low]}")
print(f"params {myna.n_params} temperature {myna.temperature} latency_ms {out['latency_ms']}")
